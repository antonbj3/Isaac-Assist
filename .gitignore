# Local pre-edit restore snapshots — keep on disk, never commit (fine-grained safety net)
*.pre_*
workspace/templates/*-old.json
workspace/templates/_retired/
workspace/templates/*.out
# Large model weights (SAM2 etc.) — too big for git, fetched separately
vision_models/
